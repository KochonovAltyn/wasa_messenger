FROM golang:1.21 AS builder

WORKDIR /src/

# Копируем go.mod и go.sum // for hash dependencies
COPY go.mod go.sum ./

# Скачиваем зависимости
RUN go mod download

# Копируем весь код
COPY . .

# Собираем приложение БЕЗ vendor.
# CGO_ENABLED=0 -> полностью статический бинарник без зависимости от системного
# GLIBC. Это возможно, потому что драйвер SQLite (modernc.org/sqlite) написан на
# чистом Go и не требует CGO. Иначе бинарник, собранный в golang:1.21 (новый GLIBC),
# не запускается в debian:bullseye-slim (старый GLIBC).
RUN CGO_ENABLED=0 go build -mod=readonly -o /app/webapi ./cmd/webapi

# Финальный образ
FROM debian:bullseye-slim

# Устанавливаем CA сертификаты
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

# Копируем скомпилированное приложение
COPY --from=builder /app/webapi /app/webapi

# Рабочая директория
WORKDIR /app

# Файл базы данных SQLite и загруженные пользователями файлы создаются во время
# работы приложения. Кладём их в /tmp, потому что рабочая директория контейнера
# может быть доступна только для чтения.
ENV CFG_DB_FILENAME=/tmp/database.db
ENV CFG_UPLOAD_DIR=/tmp/uploads

# Открываем порт
EXPOSE 3000

# Запуск
CMD ["/app/webapi"]



